{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pacs-his/schemas/task-request.schema.json",
  "title": "TaskRequest interno",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent_id",
    "objective",
    "mode",
    "data_classification",
    "artifact_refs",
    "context_ref"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "agent_id": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "documentary",
        "synthetic",
        "restricted_clinical"
      ]
    },
    "data_classification": {
      "enum": [
        "public_technical",
        "synthetic",
        "restricted_health"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
